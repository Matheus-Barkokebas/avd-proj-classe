# Copie para .env (ignorado pelo Git). Nunca versione senha nem chave.

# Neon — usuário SÓ DE LEITURA (aervita_api), o mesmo da API
NEON_DATABASE_URL=

# Chave da OpenAI, só para a ferramenta perguntar_ao_banco
OPENAI_API_KEY=
# Modelo usado (opcional)
OPENAI_MODELO=

# Modo de execução: stdio (padrão, para Claude e main.py) ou http (para o painel web)
MCP_TRANSPORTE=
# Origens do painel liberadas no CORS, separadas por vírgula (padrão: http://localhost:5173)
MCP_ORIGENS_CORS=
