# Copie para .env (ignorado pelo Git). Nunca versione senha.

# Neon — usuário SÓ DE LEITURA da API (aervita_api), não o dono do banco
NEON_DATABASE_URL=

# Origens do front liberadas no CORS, separadas por vírgula.
# Sem esta linha, libera só http://localhost:5173 (desenvolvimento); vazia, não libera nenhuma.
API_ORIGENS_CORS=http://localhost:5173

# Tempo de cache das respostas, em segundos (os dados mudam de hora em hora)
API_CACHE_SEGUNDOS=300
