# Copie este arquivo para .env (ignorado pelo Git) e preencha os valores.
# Nunca versione o .env nem cole senhas em código, conf/ ou testes.

# MongoDB Atlas — camada RAW (decisão 0001)
# Formato: mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/
MONGODB_URI=
MONGODB_DB=aervita

# Neon (PostgreSQL) — camada padronizada (decisão 0001)
NEON_DATABASE_URL=

# Onde gravar a RAW quando rodar pela linha de comando: arquivo (padrão) ou mongo
AERVITA_ARMAZENAMENTO=arquivo

# Onde gravar os dados validados: arquivo (Parquet local, padrão) ou neon
AERVITA_PADRONIZADA=arquivo
